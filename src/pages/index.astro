---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-background">
      <img src="/Images/IMG_2694.jpeg" alt="Rustic Welcome storefront at String Prairie Gardens with colorful potted plants and red door" />
    </div>
    <div class="hero-content">
      <h1>Where Nature Blooms <em>Beautifully</em></h1>
      <p class="hero-subtitle">
        Welcome to String Prairie Gardens & Barefoot Flower Farm, where we grow happiness one petal at a time.
        Discover fresh-cut flowers, heirloom plants, and the joy of bringing nature home.
      </p>
      <div class="hero-buttons">
        <a href="/visit" class="btn btn-primary">Visit Our Farm</a>
        <a href="/about" class="btn btn-secondary">Our Story</a>
      </div>
    </div>
  </section>

  <!-- Gallery Preview -->
  <section class="gallery-preview">
    <div class="gallery-grid">
      <img src="/Images/IMG_1090.jpeg" alt="Sunshine yellow ranunculus bouquet with Barefoot Flower Farm branded card" loading="lazy" decoding="async" />
      <img src="/Images/IMG_1092.jpeg" alt="Blush pink roses and ranunculus arrangement with Barefoot Flower Farm card" loading="lazy" decoding="async" />
      <img src="/Images/IMG_2834.jpeg" alt="Rustic flower shop display with vases of roses, hydrangeas, and seasonal blooms" loading="lazy" decoding="async" />
      <img src="/Images/IMG_1124.jpeg" alt="Elegant vase arrangement of lilies, chrysanthemums, and snapdragons" loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- Features Section -->
  <section class="features">
    <div class="container">
      <h2 class="section-title">Why Choose Us</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">🌱</div>
          <h3>Locally Grown</h3>
          <p>All our flowers and plants are grown right here on our farm, ensuring the freshest blooms for your home.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🌿</div>
          <h3>Sustainable Practices</h3>
          <p>We use organic methods and sustainable farming practices to nurture our plants and protect the earth.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">💚</div>
          <h3>Grown with Love</h3>
          <p>Each plant receives individual care and attention, from seed to bloom, ensuring exceptional quality.</p>
        </div>
      </div>
    </div>
  </section>



  <!-- Testimonial Section -->
  <section class="testimonial">
    <div class="container">
      <div class="testimonials-grid">
        <div class="testimonial-content">
          <blockquote>
            "Visiting Anna's farmstand at the corner of St. Mary's Rd. and McReynolds Rd. in String Prairie is an amazing delight! Then, if you want to treat yourself to the ultimate enriching experience, I highly recommend taking the four minute drive down McReynolds Rd. to visit String Prairie Gardens and Barefoot Flower Farm! Give yourself plenty of time to explore and be inspired. Anna is a wealth of gardening knowledge."
          </blockquote>
          <cite>— Happy Visitor</cite>
        </div>
        <div class="testimonial-content">
          <blockquote>
            "Professional, thoughtful, detail oriented… you won't find a kinder, more caring florist than this!"
          </blockquote>
          <cite>— Jill Schaben</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- Find Us Section -->
  <section class="find-us">
    <div class="container">
      <h2 class="section-title">Find Us</h2>
      <p class="section-subtitle">Two locations to discover in Rosanky, Texas</p>

      <div class="locations-grid">
        <div class="location-box">
          <h3>🌸 Flower Market Shop</h3>
          <p class="location-address">2989 TX-304, Rosanky, TX 78953</p>
          <div class="map-container small">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3470!2d-97.3098336!3d29.9307173!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8643625f9345ef49%3A0xfa40abca848c9ba9!2sWagon%20Wheel%20Gas%20N%20Go!5e0!3m2!1sen!2sus!4v1699999999999!5m2!1sen!2sus"
              width="100%"
              height="300"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Flower Market Shop at Wagon Wheel Gas N Go">
            </iframe>
          </div>
          <p class="location-desc">Our charming flower shop packed with fresh flowers and plants. Your first stop!</p>
        </div>

        <div class="location-box">
          <h3>🌿 Main Nursery & Venue</h3>
          <p class="location-address">440 McReynolds Rd, Rosanky, TX 78953</p>
          <div class="map-container small">
            <iframe
              src="https://maps.google.com/maps?q=440+McReynolds+Rd,+Rosanky,+TX+78953&t=&z=15&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="300"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Main Nursery and Event Venue">
            </iframe>
          </div>
          <p class="location-desc">Follow the blue arrows to our greenhouse, nursery, and gorgeous event venue with valley views.</p>
        </div>
      </div>

      <div class="directions-box">
        <span class="directions-icon">🔵</span>
        <p><strong>How to find us:</strong> Start at our Flower Market Shop at Wagon Wheel Gas N Go on TX-304, then head to McReynolds Road and follow the little blue arrows painted on the road for about 5 minutes to reach our main property.</p>
        <a href="https://www.google.com/maps/search/440+McReynolds+Rd+Rosanky+TX+78953" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Get Directions</a>
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="newsletter">
    <div class="container">
      <div class="newsletter-content">
        <h2>Join Our Garden Community</h2>
        <p>Subscribe to receive seasonal updates, gardening tips, and exclusive offers.</p>
        <form class="newsletter-form">
          <input type="email" placeholder="Your email address" required />
          <button type="submit" class="btn btn-primary">Subscribe</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
  }

  .hero-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-background::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(232, 213, 208, 0.85) 0%, rgba(250, 248, 245, 0.9) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-md);
  }

  .hero h1 {
    margin-bottom: var(--spacing-md);
    color: var(--color-sage-dark);
  }

  .hero h1 em {
    color: var(--color-terracotta);
    font-style: italic;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--color-earth);
    margin-bottom: var(--spacing-lg);
    line-height: 1.8;
  }

  .hero-buttons {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Gallery Preview */
  .gallery-preview {
    padding: 0;
    overflow: hidden;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .gallery-grid img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .gallery-grid img:hover {
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery-grid img {
      height: 200px;
    }
  }

  /* Section Styling */
  .section-title {
    text-align: center;
    margin-bottom: var(--spacing-sm);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-earth);
    margin-bottom: var(--spacing-lg);
    font-size: 1.1rem;
  }

  .section-cta {
    text-align: center;
    margin-top: var(--spacing-lg);
  }

  /* Features Section */
  .features {
    padding: var(--spacing-xl) 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-md);
  }

  .feature-card {
    background: var(--color-white);
    padding: var(--spacing-md);
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(125, 148, 113, 0.15);
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
  }

  .feature-card h3 {
    margin-bottom: var(--spacing-xs);
  }

  .feature-card p {
    color: var(--color-earth);
    margin: 0;
  }



  /* Testimonial Section */
  .testimonial {
    background: linear-gradient(135deg, var(--color-sage) 0%, var(--color-sage-dark) 100%);
    padding: var(--spacing-xl) 0;
    color: var(--color-cream);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--spacing-lg);
  }

  .testimonial-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    background: rgba(255, 255, 255, 0.1);
    padding: var(--spacing-md);
    border-radius: 12px;
  }

  blockquote {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 var(--spacing-md);
  }

  cite {
    font-style: normal;
    opacity: 0.9;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Find Us Section */
  .find-us {
    padding: var(--spacing-xl) 0;
    background: var(--color-white);
  }

  .map-container {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
    margin-bottom: var(--spacing-lg);
  }

  .map-container iframe {
    display: block;
  }

  .map-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
  }

  .info-card {
    background: var(--color-cream);
    padding: var(--spacing-md);
    border-radius: 12px;
    text-align: center;
  }

  .info-card .info-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: var(--spacing-xs);
  }

  .info-card h3 {
    margin-bottom: var(--spacing-xs);
    font-size: 1.2rem;
  }

  .info-card p {
    color: var(--color-earth);
    line-height: 1.6;
    margin: 0;
  }

  /* Dual Location Maps */
  .locations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }

  .location-box {
    background: var(--color-cream);
    border-radius: 16px;
    padding: var(--spacing-md);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .location-box h3 {
    margin: 0 0 var(--spacing-xs);
    font-size: 1.4rem;
    color: var(--color-sage-dark);
  }

  .location-address {
    color: var(--color-terracotta);
    font-weight: 600;
    margin: 0 0 var(--spacing-sm);
    font-size: 1rem;
  }

  .location-box .map-container.small {
    margin-bottom: var(--spacing-sm);
    border-radius: 12px;
  }

  .location-desc {
    color: var(--color-earth);
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
  }

  .directions-box {
    background: linear-gradient(135deg, var(--color-blush) 0%, var(--color-rose) 100%);
    padding: var(--spacing-md);
    border-radius: 12px;
    text-align: center;
  }

  .directions-box .directions-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: var(--spacing-xs);
  }

  .directions-box p {
    color: var(--color-earth);
    line-height: 1.7;
    margin: 0 0 var(--spacing-sm);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .locations-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Newsletter Section */
  .newsletter {
    padding: var(--spacing-xl) 0;
    background: var(--color-blush);
  }

  .newsletter-content {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-content h2 {
    margin-bottom: var(--spacing-xs);
  }

  .newsletter-content p {
    color: var(--color-earth);
    margin-bottom: var(--spacing-md);
  }

  .newsletter-form {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  .newsletter-form input {
    flex: 1;
    min-width: 250px;
    padding: var(--spacing-sm);
    border: 2px solid var(--color-rose);
    border-radius: 30px;
    font-family: var(--font-sans);
    font-size: 1rem;
    background: var(--color-white);
  }

  .newsletter-form input:focus {
    outline: none;
    border-color: var(--color-sage);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 50vh;
    }

    .hero-content {
      padding: var(--spacing-lg) var(--spacing-sm);
    }
  }
</style>
